# CallingBot environment configuration.
#
# Copy to .env and edit:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.
#
# Variable names are the upper-cased Settings field names from callingbot/settings.py.
# Business content (AMC profile, NFO facts, FAQs, calling window) is NOT configured here: it
# lives in config/*.yaml and must be approved by Compliance.
#
# The defaults below run fully offline: a rule-based demo bot (LLM_PROVIDER=fake) and the
# simulator (TELEPHONY_PROVIDER=simulator), so nobody is phoned and no API key is needed.
#
# Optional settings that are not in use are commented out on purpose: an empty value such as
# "TWILIO_ACCOUNT_SID=" is read as an empty string, not as "unset", and an empty number fails
# validation. Uncomment a line only when you give it a real value.
# Quote values that contain spaces, e.g. CAMPAIGN_NAME="NFO Launch", and use single quotes for
# values containing $ or other special characters, e.g. ADMIN_PASSWORD='pa$w0rd'.

# =============================================================================
# Application
# =============================================================================
# dev | test | prod
APP_ENV=dev
# SQLite for a laptop. Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/callingbot
# (needs: pip install ".[postgres]"). In the Docker image use sqlite:////app/var/callingbot.db
# or Postgres; docker-compose.yml sets a Postgres URL for you.
DATABASE_URL=sqlite:///./callingbot.db
# Folder with amc.yaml, nfo.yaml, faq.yaml, campaign.yaml
CONFIG_DIR=config
# Public HTTPS address the telephony provider can reach, without a trailing slash.
# Dev with Twilio: your ngrok URL, e.g. https://abcd-1234.ngrok-free.app
# Also used to build tracked empanelment links (/r/<token>) sent to distributors.
PUBLIC_BASE_URL=http://localhost:8000
# Signs tracked empanelment links. MUST be a long random value in production, e.g. the output of:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
# Admin dashboard login (HTTP Basic). Change both before exposing the app anywhere.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Business timezone for display and calling-window checks.
TIMEZONE=Asia/Kolkata
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# =============================================================================
# LLM (Claude via the Anthropic API)
# =============================================================================
# fake      = offline rule-based demo bot, no API key needed (default here so the demo runs offline)
# anthropic = Claude. Also set ANTHROPIC_API_KEY (see below).
LLM_PROVIDER=fake
# Default model. The AMC may evaluate others (e.g. claude-sonnet-5-5 for lower latency/cost):
# compare quality and latency on real pilot transcripts before switching.
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. "low" keeps live voice turns fast.
LLM_EFFORT=low
# Upper bound on tokens per reply, including the model's internal thinking.
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=20.0
LLM_MAX_RETRIES=2
# Server-side refusal fallback on the Claude API. Set false if requests are routed via a cloud
# platform (Bedrock / Vertex AI / Foundry) instead of the Anthropic API.
LLM_ENABLE_FALLBACKS=true

# The Anthropic SDK reads the API key from the PROCESS ENVIRONMENT, not from Settings.
# - Docker Compose: putting it here works (env_file passes it into the containers).
# - Local "make run"/"make simulate"/"make dialer": works (the Makefile passes this key through).
# - Running "callingbot ..." directly: export it in your shell first:
#     export ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# =============================================================================
# Telephony
# =============================================================================
# simulator = no phone calls (web simulator at /simulator, "callingbot simulate" in a terminal)
# twilio    = real calls via Twilio (pilots/testing; see docs/COMPLIANCE.md before live outreach)
# exotel    = Indian CPaaS; outbound dialling + status only until Phase 3 (Voicebot streaming)
TELEPHONY_PROVIDER=simulator

# --- Twilio (TELEPHONY_PROVIDER=twilio) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=REPLACE-ME
# Caller ID in E.164, a number you own or have verified in Twilio
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Reject webhooks without a valid X-Twilio-Signature. Keep true outside local experiments.
TWILIO_VALIDATE_SIGNATURE=true
# Answering-machine detection (lets the bot hang up on voicemail instead of pitching to it).
TWILIO_MACHINE_DETECTION=true
# Record whole calls at Twilio. The approved greeting already announces recording; agree a
# retention period with Compliance before switching this on.
TWILIO_RECORD_CALLS=false

# --- Exotel (TELEPHONY_PROVIDER=exotel) ---
# EXOTEL_ACCOUNT_SID=your-exotel-sid
# EXOTEL_API_KEY=REPLACE-ME
# EXOTEL_API_TOKEN=REPLACE-ME
# API host for your account's region (Exotel shows it in the API settings page)
EXOTEL_SUBDOMAIN=api.exotel.com
# Your ExoPhone / DLT-registered virtual number used as caller ID
# EXOTEL_CALLER_ID=0XXXXXXXXXX
# Id of the Exotel flow (App Bazaar applet) the call is connected to
# EXOTEL_APP_ID=123456

# =============================================================================
# Call behaviour
# =============================================================================
# Distributor replies handled per call before the bot wraps up
MAX_CALL_TURNS=24
# Hard limit on call length in seconds (wrap-up, then forced close)
MAX_CALL_SECONDS=420
# Re-prompts after silence before a polite hang-up
NO_INPUT_REPROMPTS=1
# Seconds to wait for the distributor to start speaking
GATHER_TIMEOUT_SECONDS=6
# Human relationship-manager desk for warm transfers (E.164). Optional: without it live transfers
# are unavailable and the bot offers an RM callback instead.
# RM_TRANSFER_NUMBER=+91XXXXXXXXXX

# =============================================================================
# Messaging (empanelment links and follow-ups)
# =============================================================================
# "outbox" only stores the message in the database (visible in the dashboard) for manual
# sending. Switch to a real provider only after DLT SMS templates / WhatsApp templates /
# email domain are approved (see docs/COMPLIANCE.md).
SMS_PROVIDER=outbox
WHATSAPP_PROVIDER=outbox
EMAIL_PROVIDER=outbox

# --- Email (EMAIL_PROVIDER=smtp) ---
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=partners@your-amc.example
# SMTP_PASSWORD=REPLACE-ME
# SMTP_FROM=Your AMC Partners <partners@your-amc.example>
SMTP_STARTTLS=true

# --- SMS via Twilio (SMS_PROVIDER=twilio) ---
# TWILIO_SMS_FROM=+1XXXXXXXXXX

# --- WhatsApp via Meta Cloud API (WHATSAPP_PROVIDER=meta) ---
# META_WHATSAPP_TOKEN=REPLACE-ME
# META_WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Name of the approved template that carries the empanelment link
# META_WHATSAPP_TEMPLATE_NAME=empanelment_link
META_WHATSAPP_TEMPLATE_LANGUAGE=en

# =============================================================================
# Docker Compose only (not read by the app)
# =============================================================================
# Campaign the "dialer" service dials. Create it first: callingbot campaign create "NFO Launch"
CAMPAIGN_NAME="NFO Launch"
# Password for the bundled Postgres container. Change it.
POSTGRES_PASSWORD=change-me-postgres
